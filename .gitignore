# ---- Student data (FERPA) — never commit -----------------------------------
# What this tool produces is a named list of students with photographs, grades
# and schedules. Ignore by shape, so a file dropped in here is never one
# `git add -A` away from being published.
*.html
*.pdf
*.csv
*.json
roster.json
out/

# ---- Build output ----------------------------------------------------------
# docs/ is what build.py writes. The Publish workflow builds it from src/ and
# deploys it, so a committed copy could only ever be stale.
docs/

# ---- macOS / editors -------------------------------------------------------
.DS_Store
.vscode/
*.swp

# ---- Python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
